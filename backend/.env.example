# Backend Environment Variables (EXAMPLE ONLY - do NOT commit real values)
# Copy this to .env and fill in your actual values

EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
GROQ_API_KEY=your-groq-api-key
DJANGO_SECRET_KEY=your-secret-key-here
STRIPE_TEST_PUBLIC_KEY=pk_test_your_key_here
STRIPE_TEST_SECRET_KEY=sk_test_your_key_here
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
# Optional: lower this only if you are tuning reCAPTCHA v3 risk scoring.
RECAPTCHA_MIN_SCORE=0.5
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Or set these three instead of CLOUDINARY_URL:
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
